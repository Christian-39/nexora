# ============================================================================
# NEXORA — environment configuration (backend/.env)
#
# This file configures the DEPLOYMENT: secrets, database, Redis, storage,
# push keys and allowed origins. It is read exactly once, by config/settings.py,
# through python-decouple (`from decouple import config`). Application code
# never reads the environment directly.
#
# The ORGANIZATION's configuration (name, branding, colours, policies,
# messaging limits, feature switches, security policy) is NOT here — it lives
# in the database and is edited by the administrator in Settings.
#
# Copy to backend/.env and fill in. Never commit the real .env.
# ============================================================================

# --- Mode -------------------------------------------------------------------
# production | development | test
DJANGO_ENV=development
DEBUG=True
LOG_LEVEL=INFO
TIME_ZONE=UTC

# --- Secrets ----------------------------------------------------------------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-unique-value-of-at-least-32-characters

# --- Hosts / origins --------------------------------------------------------
# Comma-separated. Whitespace and empty entries are ignored.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# The origin(s) the frontend is served from. In DEBUG the common local static
# server ports (5500, 5501, 8080, 3000, 5173 ...) are added automatically.
# CORS_ALLOW_ALL_ORIGINS is never enabled, in any mode.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Database (MySQL 8+ in production) --------------------------------------
# Either DATABASE_URL ...
DATABASE_URL=
# ... or the discrete values:
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=nexora
DATABASE_USER=nexora
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_CONN_MAX_AGE=60
# With neither set and DEBUG=True, SQLite is used for local development only.

# --- Redis (channel layer, cache, presence) ---------------------------------
# Mandatory in production: an EXTERNAL managed Redis, reached over the network.
# Production refuses to boot without it and never falls back to the in-memory
# channel layer (that layer cannot deliver events between ASGI processes).
# Leave empty locally to use the in-memory layer.
#   redis://:password@host:6379/0        rediss://…  for TLS
REDIS_URL=
# Set to "none" only if a managed provider's TLS certificate cannot be verified
# by the host trust store. The connection stays encrypted either way.
REDIS_SSL_CERT_REQS=
CACHE_KEY_PREFIX=nexora
PRESENCE_TTL_SECONDS=120

# --- Session cookies --------------------------------------------------------
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
ACCESS_COOKIE=nexora_access
REFRESH_COOKIE=nexora_refresh
# Lax when the frontend and API share a site; None (with COOKIE_SECURE=True)
# when they are on different sites.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=False
COOKIE_DOMAIN=
CSRF_COOKIE_NAME=csrftoken

# --- Private object storage (S3-compatible) ---------------------------------
# Mandatory in production. Leave empty to store on the local filesystem
# (development only). Objects are always private; access is authorized by the
# backend before a short-lived signed URL is issued.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300

# --- Media pipeline ---------------------------------------------------------
# Hard ceilings. Per-organization limits are set in the admin Settings screen
# and are always applied on top of these.
MAX_UPLOAD_SIZE=2147483648
MAX_IMAGE_PIXELS=50000000
MEDIA_THUMBNAIL_SIZE=480
MEDIA_OPTIMIZED_SIZE=1600
MEDIA_WEBP_ENABLED=True
# True generates derivatives inside the request (small deployments / tests).
# False (recommended) leaves them to `python manage.py media_worker`.
MEDIA_PROCESS_INLINE=False
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- Web push (VAPID) -------------------------------------------------------
# Generate a key pair:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
# The private key is never sent to a browser and never appears in the API.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_CONTACT=mailto:admin@example.org
PUSH_MAX_ATTEMPTS=5
PUSH_AGGREGATION_WINDOW_SECONDS=60

# --- Throttling -------------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_MESSAGES=120/min
THROTTLE_SEARCH=30/min
THROTTLE_UPLOADS=60/hour
THROTTLE_PUSH=30/hour
THROTTLE_CREDENTIALS=10/hour
API_PAGE_SIZE=30

# --- HTTPS / security headers ----------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
