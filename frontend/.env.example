# ============================================================================
# NEXORA Frontend — Environment Configuration Example
# ============================================================================
# The static frontend resolves the backend origin centrally in
# `frontend/assets/js/config.js` via `<meta name="nexora-api-base">`,
# `<script id="nexora-config" type="application/json">`, `window.NEXORA_RUNTIME`,
# or `API_BASE_URL` during static deployment/injection.
#
# Production backend URL (Render):
API_BASE_URL=https://nexora-f397.onrender.com

# API path prefix and authentication transport ('cookie' or 'bearer'):
API_PREFIX=/api
AUTH_MODE=cookie

# Local development backend port (used automatically when served from
# localhost / 127.0.0.1 unless API_BASE_URL / nexora-api-base is explicitly set):
LOCAL_API_PORT=8000
