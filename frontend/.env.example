# Local split development: static frontend at :5500, Django API at :8000.
# Copy this file to .env, then run `node build.mjs` and serve `dist/`.
# This is a local example only; do not use a loopback origin in Vercel.
API_BASE_URL=http://127.0.0.1:8000

# For a same-origin reverse proxy instead, use the explicit value below.
# API_BASE_URL=same-origin
#
# Vercel: set API_BASE_URL in Project → Settings → Environment Variables to
# the public HTTPS Security Relay origin (never the private Django service).
# The production build rejects blank, loopback, and HTTP origins unless
# same-origin trusted proxy mode is explicit.
# API_BASE_URL is public client configuration, never a secret.
